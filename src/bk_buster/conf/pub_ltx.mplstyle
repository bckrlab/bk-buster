# TeX!
text.usetex: True
text.latex.preamble: "\usepackage{lmodern}"

# fig
figure.facecolor: "#FFFFFF"
figure.constrained_layout.use: False
# figure.dpi: 300
text.hinting_factor : 8
patch.antialiased: True

# fonts
font.family: serif
axes.labelsize: 10
font.size: 10
xtick.labelsize: 8
ytick.labelsize: 8
legend.fontsize: 7

# set x axis
xtick.direction: out
xtick.major.size: 3
xtick.major.width: 1.0
xtick.minor.size: 1.5
xtick.minor.width: 0.5
xtick.minor.visible: False
xtick.top: False

# set y axis
ytick.direction: out
ytick.major.size: 3
ytick.major.width: 1.0
ytick.minor.size: 1.5
ytick.minor.width: 0.5
ytick.minor.visible: False
ytick.right: False

# grid
axes.grid: True
grid.color: "#e5e5e5"
grid.linestyle: dashed
grid.linewidth: 1.0

# line widths
axes.linewidth: 1.0
lines.linewidth: 1.0

# legend
legend.frameon: True
legend.fancybox: True

# saving
savefig.pad_inches: 0.05